# Agora Conversational AI
# AGORA_APP_ID and AGORA_APP_CERTIFICATE are used for RTC token generation.
# AGORA_CUSTOMER_ID and AGORA_CUSTOMER_SECRET are optional (reserved for future REST APIs).
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
AGORA_CUSTOMER_ID=your_agora_customer_id
AGORA_CUSTOMER_SECRET=your_agora_customer_secret
AGORA_CHANNEL_NAME=sevavoice-hindi-demo

# Murf AI (Falcon TTS)
MURF_API_KEY=your_murf_api_key
MURF_MODEL=falcon
MURF_VOICE_ID=hi-IN-female-1
MURF_LOCALE=hi-IN

# App
PORT=8000
DEBUG=true
LANGUAGE=hi-IN